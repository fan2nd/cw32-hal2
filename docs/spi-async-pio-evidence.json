  "register_semantics": {
    "ier": {
      "txe": 0,
      "rxne": 1,
      "ssf": 2,
      "ssr": 3,
      "ud": 4,
      "ov": 5,
      "sserr": 6,
      "modf": 7
    },
    "isr": {
      "txe": 0,
      "rxne": 1,
      "ssf": 2,
      "ssr": 3,
      "ud": 4,
      "ov": 5,
      "sserr": 6,
      "modf": 7,
      "busy": 8,
      "access": "read_only"
    },
    "icr": {
      "semantics": "R1W0; no W1C SPI clearing",
      "write_noop": 255,
      "reserved_bits": "31:8 remain zero",
      "flush_bit": 0,
      "flush_zero": "destructively empties transmit buffer and shift register and sets TXE",
      "rxne_zero": "clears receive-ready flag",
      "normal_ready_service": "write DR consumes TXE; read DR consumes RXNE; no ICR write needed",
      "command_policy": "Start from existing typed Icr::write_noop(), issue explicit W0 commands, never ICR read-modify-write; whole clear only disabled initialization or existing destructive PIO error recovery."
    },
    "layouts": [
      {
        "versions": [
          "v1",
          "cw32f002_v1",
          "cw32l031_v1"
        ],
        "ier_offset": 4,
        "isr_offset": 16,
        "icr_offset": 20,
        "dr_offset": 24,
        "enable_register": "CR1",
        "enable_bit": 6
      },
      {
        "versions": [
          "cw32l010_v1",
          "cw32l012_v1"
        ],
        "ier_offset": 16,
        "isr_offset": 20,
        "icr_offset": 24,
        "dr_offset": 28,
        "enable_register": "CR2",
        "enable_bit": 0
      }
    ],
    "data_width": "u8 API uses WIDTH=7 and existing 32-bit typed DR accesses to its 16-bit field, not unreviewed raw byte MMIO.",
    "wire_completion": "Every successful awaited operation, including flush, requires no error, TXE=1 and BUSY=0. TXE alone is only transmit-buffer availability.",
    "busy_notification": "No BUSY-clear IRQ exists in any of the five actual SPI IP versions. Finishing cooperatively self-wakes; overall completion is not time-bounded.",
    "en_disable": "Own manuals define EN read/write, zero disabling the module; no idle-only restriction is stated. Destructive PIO teardown may truncate a frame and is not acknowledged successful wire completion. Native CR1 configuration requires CR2.EN=0.",
