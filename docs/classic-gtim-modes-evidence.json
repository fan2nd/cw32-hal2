          8
        ],
        "CC4M": [
          15,
          12
        ]
      },
      "values": [
        {
          "value": 0,
          "name": "DISABLED",
          "meaning": "No capture/compare channel function."
        },
        {
          "value": 1,
          "name": "CAPTURE_RISING",
          "meaning": "Capture on a rising edge."
        },
        {
          "value": 2,
          "name": "CAPTURE_FALLING",
          "meaning": "Capture on a falling edge."
        },
        {
          "value": 3,
          "name": "CAPTURE_BOTH",
          "meaning": "Capture on both rising and falling edges."
        },
        {
          "value": 8,
          "name": "FORCE_LOW",
          "meaning": "Force the channel output low."
        },
        {
          "value": 9,
          "name": "FORCE_HIGH",
          "meaning": "Force the channel output high."
        },
        {
          "value": 10,
          "name": "COMPARE_LOW",
          "meaning": "Set the channel output low on a compare match."
        },
        {
          "value": 11,
          "name": "COMPARE_HIGH",
          "meaning": "Set the channel output high on a compare match."
        },
        {
          "value": 14,
          "name": "PWM_HIGH_AT_OR_ABOVE",
          "meaning": "PWM output is high when CNT >= CCR."
        },
        {
          "value": 15,
          "name": "PWM_HIGH_BELOW",
          "meaning": "PWM output is high when CNT < CCR."
        }
      ],
      "unqualified_values": [
        4,
        5,
        6,
        7,
        12,
        13
      ],
      "unqualified_policy": "The selected own-manual CMMR tables do not define these encodings. Leave unnamed; do not infer a toggle mode from SDK constants."
    },
    "Mode": {
      "width": 2,
      "field_bits": [
        2,
        1
      ],
      "values": [
        {
          "value": 0,
          "name": "TIMER",
          "meaning": "Timer mode: PCLK is the input clock source; the prescaler supplies the counter clock."
        },
        {
          "value": 1,
          "name": "COUNTER",
          "meaning": "Counter mode: the TRS-selected ETR or ITR signal is the input clock source; the prescaler supplies the counter clock."
        },
        {
          "value": 2,
          "name": "TRIGGER_START",
          "meaning": "Trigger-start mode: PCLK supplies the prescaler. Software EN=1 or a valid TRS trigger starts counting; a valid trigger sets EN and TI."
        },
        {
          "value": 3,
          "name": "GATED",
          "meaning": "Gated mode: PCLK supplies the prescaler; counting requires EN=1 and an active ETR gate level."
        }
      ]
    }
  },
  "common_qualifications": [
    "CR0.MODE governs normal operation when CR0.ENCMODE=0; nonzero ENCMODE selects encoder counting instead.",
    "CR0.TRS=0 selects ETR; CR0.TRS=1 selects the internal ITR signal.",
    "For ETR, CR0.POL=0 selects the rising edge in trigger/counter modes and the high level in gated mode; POL=1 selects falling edge/low level.",
    "Trigger-start does not mean trigger-only: software can set EN=1. A valid trigger sets EN and the TI interrupt flag.",
    "Gated mode uses ETR as its gate; TRS selecting ITR does not change the documented ETR gate source.",
    "CC2M, CC3M and CC4M explicitly refer to the same manual CC1M definition; no channel semantics are inferred across families."
  ],
