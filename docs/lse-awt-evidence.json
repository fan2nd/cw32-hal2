  "semantics": {
    "configuration": "PCLK configuration access is independent of the SRC-selected counting clock. APBEN2.AWT controls configuration access only. Configure SRC/PRS/MD before EN; do not change source or prescaler while running.",
    "reload": "EN activation loads ARR; ARR writes affect the next cycle without changing the current CNT. Period contains (ARR+1)*2^PRS source cycles.",
    "acknowledgment": "IER/ISR.UD is bit3. ICR.UD is R1W0 with write1 no effect. Preserve the existing 0x3f no-op seed and clear only UD.",
    "source_loss": "No documented AWT source-loss fallback, forced EN clear, guaranteed new UD, frozen CNT value or wait completion. SYSCLK fallback statements do not change AWT.SRC. An event may predate an unhealthy-source observation.",
    "configuration_after_loss": "Independent configuration-clock documentation supports bounded local register operations if CPU/PCLK function; this is a design inference, not a measured bus-latency or synchronization guarantee. No wait-for-LSE-edge loop is added.",
    "health": "Reuse the existing frozen LseClock state and ready observation. EN/STABLE, parameters, sticky fault and frozen monitor observations are not frequency measurement or future liveness guarantees. A deadline requires an independent wake source.",
    "ownership": "Hold the real LseClock, SYSCTRL and mode-required pads through AWT lifetime. One capability cannot construct independent live AWT and RTC source owners. Source/pads survive errors, Drop and forgetting; no release or source clone.",
    "gpio_handover": "LseClock acquisition/reacquisition may temporarily enable all of GPIOC for existing pad inspection, advancing sampling, filters and armed edges even before error. AWT health observation does not scan recipient banks.",
    "recipients": "AWT underflow and IRQ exist across the cohort. L031/R031/W031 GPIOA/B/C/F FILTER7 selects AWT underflow; inherited filters can observe takeover, start, stop, period changes, Drop, forgetting and source loss. AWT token ownership does not prove recipient quiescence. This is a functional handover limit, not a hidden Rust memory-safety prerequisite.",
    "separate_blocks": "AWT_ETR is an input. RTC AWTSRC/AWTARR/AWTIMER is a separate RTC timer, not a standalone AWT output. No AWT-driven DMA/memory recipient is qualified.",
    "historical_mapping": "Historical low-power-timers-evidence.json keeps its original bytes. Current F020/F030/A030 uses awt_cw32f030_v1; L031/R031/W031 uses awt_cw32l031_v1; F002/F003 awt_v1 selector2/3 is HEX_PB0/HEX_PB1 and never LSE."
  },
  "board_contract": {
    "per_cycle_bounds_required": true,
    "nominal_hz": 32768,
    "maximum_hz": 1000000,
    "bounds_rule": "Nonzero minimum <= nominal <= maximum; all per-cycle, voltage, temperature, aging, loading, drive/amplitude and bypass waveform qualifications remain with the board. Average ppm is insufficient.",
    "startup_maximum_guaranteed": false,
    "w031_supply_policy": "Existing mode-independent LDO/DCDC intersection 2000..3600mV; no implicit 1800mV DCDC admission."
  },
