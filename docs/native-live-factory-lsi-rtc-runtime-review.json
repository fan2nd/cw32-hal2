  "static_findings": [
    {
      "name": "read_only_native_lease",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rcc/rtc.rs"
      ],
      "finding": "NotInitialized precedes acquisition; own halfword u16 max rejects; local typed setter normalizes; one critical section reads CR1, LSI, LSI, CR1; calibration errors precede enable/readiness errors; no writes or poll loop."
    },
    {
      "name": "repeated_readiness",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rcc/rtc.rs"
      ],
      "finding": "Every native Lsi is_ready call repeats the same factory comparison and four hardware samples; retained source loss maps through existing ClockNotReady."
    },
    {
      "name": "ownership_and_api",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rcc/rtc.rs",
        "embassy-cw32/src/rcc/mod.rs"
      ],
      "finding": "Unique Peri<SYSCTRL>, no clone or drop mutation; native one-argument constructor, unchanged native default HSIOSC and classic two-argument constructor; cfg-qualified enum arm and conversion."
    },
    {
      "name": "rate_only_fraction",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rcc/rtc.rs",
        "embassy-cw32/src/rcc/bounds.rs"
      ],
      "finding": "Uses shared RCC_LSI constants and ClockBounds::lsi, not HSI Instance constants or selected SYSCLK; /32800 retains rate_only; strict duration guards and arithmetic unchanged."
    },
    {
      "name": "domain_helper_and_old_zero_mmio",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "Reads existing RccInfo is_enabled then reset_asserted only when concrete native_lsi=true; false returns immediately. Gate acknowledgement behavior is unchanged."
    },
    {
      "name": "attach_and_identity",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "After gate enable, concrete source/access observations are guarded; SOURCE2, exact 1/16400 pair and disabled compensation are required; alternate pair cannot pass. Attach has no KEY, reset, source, flag or calendar mutation."
    },
    {
      "name": "unset_and_start",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "L010 independently guards START and CR0/CR2/COMP/IER samples; moves sole DATE observation after ACCESS-free and WAIT. L011/L012 guard both controls/ISR observations around WAIT. H24 write uses fresh zero control, preserving START=0 until final explicit START."
    },
    {
      "name": "source_before_divisor",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "Incoming PSC read bracketed before staged_first calculation; staged first uses widened u16 and max; staged PSC acknowledged, source readiness resampled, SOURCE2 written and acknowledged before final divisors. Persistent available-domain SOURCE0 yields WriteFailure without final PSC/H24/DATE/TIME/START."
    },
    {
      "name": "poll_error_precedence",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "Each new-source poll captures guard failure and stops via true sentinel, then performs final domain check and prioritizes retained error before original result; no sentinel may acknowledge a write."
    },
    {
      "name": "guarded_calendar_operations",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "START and repeated snapshots are bracketed; WAIT guarded; repeated snapshot guard lies in original critical section and precedes decode; exhausted retries recheck domain. DATE/TIME writes each bracketed; WAIT and pair readbacks guarded."
    },
    {
      "name": "l010_write_refusal",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "After existing read-only check_clock, check_write_mode and check_access_free, native L010 returns UnqualifiedWriteTiming before wait_load, KEY, ACCESS, DATE or TIME."
    },
    {
      "name": "direct_correction",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs"
      ],
      "finding": "L011/L012 retain stop/WAIT/write/restart, guard saved format and each control write/readback, and return through explicit cleanup. No ACCESS/WINDOW use is introduced."
    },
    {
      "name": "synchronous_alarms",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/alarm.rs"
      ],
      "finding": "Permission/format/status tuples guard before interpretation; ALARMA, CR2 and ICR writes guard before/after; existing readbacks guard. CR2 update uses guarded saved typed value. Four fixed operations use guarded unlock/explicit finish in original critical section."
    },
    {
      "name": "unlock_and_all_failure_cleanup",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/mod.rs",
        "embassy-cw32/src/rtc/alarm.rs"
      ],
      "finding": "Constructor checks before both original KEY writes and after second; failures create no guard. All three normal native scopes capture result, suppress relock on domain error, otherwise finish explicitly. Finish suppresses Drop before checks and prioritizes cleanup domain failure. Fallback Drop stops remaining writes after observed loss; old false flags keep exact old writes and zero new status reads."
    },
    {
      "name": "async_and_forgotten_guard",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rtc/alarm_interrupt.rs"
      ],
      "finding": "Only diff is leading four-line cfg-qualified refusal. New source installs no wait state. Old setup, ACTIVE/WAKER, ISR, pending poll, Unlocked calls and WaitGuard Drop are byte-identical; forgotten old guard behavior is preserved, not repaired or upgraded."
    },
    {
      "name": "legacy_compatibility",
      "status": "pass_static_inspection",
      "source_paths": [
        "embassy-cw32/src/rcc/rtc.rs",
        "embassy-cw32/src/rcc/mod.rs",
        "embassy-cw32/src/rtc/mod.rs",
        "embassy-cw32/src/rtc/alarm.rs",
        "embassy-cw32/src/rtc/alarm_interrupt.rs"
      ],
      "finding": "Old HSI/LSE/classic branches retain register operation order; added false domain calls do no MMIO. Baseline native HSI constructor, classic constructor, LSE implementation, default aliases and bounds functional bytes preserved. Public enum shape change is explicitly documented."
    },
    {
      "name": "ordinary_example",
      "status": "pass_static_inspection",
      "source_paths": [
        "examples/rtc-calendar/Cargo.toml",
        "examples/rtc-calendar/build.rs",
        "examples/rtc-calendar/src/bin/live_lsi_calendar.rs"
      ],
      "finding": "Feature/bin are bounded to exact seven; hsi marker retained. Default HSI init, read-only LSI lease, explicit stopped-unset date and black_box(now,bounds) loop; no peripheral extras, oscillator mutation, async, strict duration calls or hardware claim."
    },
    {
      "name": "public_scope",
      "status": "pass_static_inspection",
      "source_paths": [
