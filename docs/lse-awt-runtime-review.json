  "runtime_findings": [
    {
      "subject": "Additive exact-eight owned source API",
      "result": "accepted",
      "basis": "The two constructors retain private Option<LseClock>; old constructors pass None and keep HSIOSC. No clone/share/extract or mutation API is added."
    },
    {
      "subject": "Admission and errors",
      "result": "accepted",
      "basis": "Reserved PRS then RCC validation preserve old precedence. One LSE health sample precedes AWT/gate writes. Gate/reset side effects are preserved; no new post-programming errors or source teardown."
    },
    {
      "subject": "Local construction order",
      "result": "accepted",
      "basis": "Within critical section: enable gate, reject asserted reset, EN=0, mask UD, selected SRC/MD/PRS with EN=0, ARR, clear hardware/software events, install mode/local IER. NVIC enable follows successful common initialization."
    },
    {
      "subject": "Immutable source and bounds",
      "result": "accepted",
      "basis": "set_config derives selector and rational bounds from the held root, never previous divided tick; stops/configures/clears events, retains source, leaves stopped and does not add health monitoring."
    },
    {
      "subject": "Health snapshot and retained event semantics",
      "result": "accepted",
      "basis": "Readiness directly uses held LSE predicate or HSIEN/STABLE; no pad scan, fault/event clear, IRQ installation, recovery or wake. Retained UD is consumed independently; absent an event wait may remain pending after loss."
    },
    {
      "subject": "ISR, cancellation, Drop, forgetting and reconstruction",
      "result": "accepted",
      "basis": "Twelve existing bodies are byte-identical. Static state owns its Waker and no source/object pointer. Drop remains local stop/mask/inactivate; safe forget and pre-write failed reconstruction preserve prior hardware/event effects; successful replacement clears old local retention."
    },
    {
      "subject": "RTC, pads and downstream recipients",
      "result": "accepted",
      "basis": "Existing RCC/RTC/GPIO helpers are unchanged. Source/pad reservations and retained RTC consumers remain; there is no simultaneous independent RTC/AWT sharing. GPIOC acquisition and FILTER7 effects are explicit functional limitations, with no new recipient scan or hidden Rust safety prerequisite."
    },
    {
      "subject": "Actual generated metadata admission",
      "result": "accepted_after_correction",
      "basis": "Exact identity and current LSE/AWT intersection checked in both directions, plus existing source=3/IP/pins/PCLK/reset/IRQ/IR. Gate/reset expected strings now match sanitized Rust metadata; canonical hardware data unchanged. Actual Cargo output enables awt_lse on eight exact libraries and excludes three controls."
    },
    {
      "subject": "Real example integration",
      "result": "accepted",
      "basis": "Nondefault required-feature bin uses real RCC/LseClock acquisition, Blocking polling, unconditional Drop after a bounded iteration phase, genuine reborrow/reacquisition and typed Async AWT wait. Both constructors link. No event/deadline/low-power guarantee; old control binaries unchanged."
    },
    {
      "subject": "Documentation and capability boundary",
      "result": "accepted",
      "basis": "Owned source, health/event independence, source-loss nonprogress, GPIOC window, FILTER7, forgetting, retained RTC and hardware limits match actual implementation. Existing bounded_api/partial remains."
    }
  ],
