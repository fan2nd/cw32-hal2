  "checks": [
    {
      "subject": "Exact3 boundary",
      "result": "accepted",
      "finding": "Only CW32L031C8T6/LQFP48, CW32L031C8U6/QFN48 and CW32L031F8U6/QFN20 gain the capability after all checks. Each retains 64 KiB Flash and 8 KiB SRAM. Generic/other L031 and all R031/W031 remain absent."
    },
    {
      "subject": "Own rate and factory facts",
      "result": "accepted",
      "finding": "Own DS binds 32,800 Hz nominal, 31,816..33,784 Hz, 1.65..5.5 V and -40..85 C. Own RM/SDK bind one native halfword factory location 0x00100A02, TRIM[9:0], preserved WAIT[11:10] and STABLE[15]."
    },
    {
      "subject": "Complete unique rosters",
      "result": "accepted",
      "finding": "Explicit required identities match all 53 fields, nine gates, three UARTs, four GPIO banks and ten addresses. Independent selected-SVD comparison matches all 53 fields and 18 gate/reset positions; registers/access, enable-high/reset-low/unkeyed protocol and own IRQ4 are retained."
    },
    {
      "subject": "PB11 and documented filter policy",
      "result": "accepted",
      "finding": "PB11 is bonded only on the two C8 packages; F8U6 register inspection is conservative policy. Own RM identifies FLTCLK7 as AWT overflow; exclusion is not a reserved-encoding claim. MCO7 and PB11 AF2/4 remain separate undocumented exclusions."
    },
    {
      "subject": "Own interrupt name",
      "result": "accepted",
      "finding": "RM RCC global IRQ4 is named SYSCTRL in the own SVD, SDK and existing PAC. The corrected policy and L031-only generator/HAL assertions use SYSCTRL+4; prior families retain RCC with their prior numbers."
    },
    {
      "subject": "Masks and access",
      "result": "accepted",
      "finding": "IR-derived source masks remove only read-only STABLE and retain every parameter/reserved bit. LSI/HSI/LSE masks are 0xffff7fff; HSE is 0xfff7ffff. Existing generated PAC fields retain getters without STABLE setters."
    },
    {
      "subject": "Strict consumer windows",
      "result": "accepted",
      "finding": "Actual exact3 output has nine inspection windows, eleven selectors, one combined GPIOB FILTER/AFR11 read, and nine captured relevant-fault checks. Central enable/restore errors precede original-gate verification, faults, post-reset and buffered semantic release."
    },
    {
      "subject": "Signature and old-path isolation",
      "result": "accepted",
      "finding": "Only L031 receives monitor_hse/monitor_lse arguments. F002/F003 alone retain HEX index search; classic windows remain unchanged. Actual F003E4P7 and F030C8T7 factory blocks are byte-identical to baseline blocks."
    },
    {
      "subject": "Projected external ownership",
      "result": "accepted",
      "finding": "HSE indices are derived from actual projected pads: GPIOF index8 for both C8 parts and None/None for F8U6. Existing LSE GPIOC inspection restores the original gate; no LSE gate advancement is introduced. Pad-local helper contracts are unchanged."
    },
    {
      "subject": "Narrow native coexistence",
      "result": "accepted",
      "finding": "Only exact3 L031 coexistence relaxes the native-LSE absence assertion, with own RTC/LSI numerical equality. L010/L011/L012 and other native cohorts retain their existing assertions/capability absence."
    },
    {
      "subject": "All-chip and PAC preservation",
      "result": "accepted",
      "finding": "All 54 objects compared: exactly three only gain SYSCTRL.clock_limits.lsi_sysclk; 51 objects otherwise unchanged. All 138 peripheral register files and all 54 chip pac.rs files are byte-identical. No whole-generated-metadata-text equality claim is made."
    },
    {
      "subject": "Model and previous policy preservation",
      "result": "accepted",
      "finding": "Prior five family policy objects, all serde/PAC-generator/authored-register files and source lock are unchanged. Electrical profile change is only the policy digest; no model or schema change."
    }
  ],
  "resolved_finding": {
    "subject": "Own IRQ symbol correction",
    "initial_failure": "Generation-v1 rejected the old-family RCC name assumption.",
    "source_fact": "RM IRQ4 is named RCC globally; own SVD, SDK and unchanged PAC expose SYSCTRL.",
    "resolution": "Use SYSCTRL only for L031 in policy, data validator, HAL builder and selected runtime observer; preserve prior families and IRQ number.",
    "generation_v2_exit": 0
  },
