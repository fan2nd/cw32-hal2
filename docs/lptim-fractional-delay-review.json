  "arithmetic_review": {
    "existing_defect": "enable writes EN before dividing by the whole-hertz floor of a positive timer lower bound; supported sub-hertz ticks produce a zero denominator and panic instead of an Error return.",
    "supported_witness": {
      "part": "CW32L010F8P6",
      "sysclk": "LSE",
      "nominal_hz": 32768,
      "source_minimum_hz": 32766,
      "source_maximum_hz": 32770,
      "retained_hsi_divisor": 12,
      "ahb_divisor": 128,
      "apb_divisor": 8,
      "lptim_divisor": 128,
      "cpu_upper_exact_hz": "32770/128",
      "cpu_upper_whole_hz": 257,
      "timer_lower_exact_hz": "32766/131072",
      "timer_lower_whole_hz": 0,
      "new_delay_cpu_cycles": 2049,
      "preconditions": "Successful current RCC initialization, existing qualified physical board/source/pad/handover conditions, no fixed-1-MHz time-driver feature; not a claim of observed board admission."
    },
    "formula": "ceil(Smax * timer_divisor * 2 / (cpu_divisor * Smin)) = ceil(2 * APB_divisor * LPTIM_divisor * Smax / Smin)",
    "intermediate_bounds": {
      "source_numerators": "positive u32, with external zero minima rejected and PLL multiplication checked",
      "source_divisor_maximum": 32,
      "cpu_divisor_maximum": 4096,
      "timer_divisor_maximum": 4194304,
      "u64_numerator": "< 2^55",
      "u64_denominator": "positive and < 2^44"
    },
    "source_ratio_bounds": {
      "HSI": "102/98 on all five current LPTIM families",
      "HSE": "at most 8 from admitted 4..32 MHz endpoints",
      "LSI": "33784/31816 on the currently qualified L052/L083 SYSCLK exact parts; L010/L011/L012 have no admitted LSI SYSCLK path",
      "PLL": "current L083 HSI/HSE-fed positive checked multiplier preserves the source endpoint ratio",
      "LSE": "minimum >=1 Hz; native L010/L011/L012 maximum <=100000 Hz; L052/L083 maximum <=1000000 Hz; detector checks can tighten admission",
      "loose_universal_maximum": 1000000
    },
    "maximum_delay_cpu_cycles": 2048000000,
    "u32_maximum": 4294967295,
    "unchanged_u32_cast_lossless": true,
    "rounding": "Whenever the old floor denominator is positive, ceil(2*ceil(H)/floor(T)) >= ceil(2*H/T). Integer rates agree; the exact-fraction calculation removes excess outward rounding while retaining a final ceiling.",
    "timing_scope": "HCLK and the configured PCLK-backed timer share the same frozen SYSCLK and integer divider chain. This is a relative common-source cycle wait, including rate-only LSI/PLL. No absolute period, jitter, upper deadline, watchdog, source-loss, dynamic retuning, fallback, or deep-sleep guarantee is added.",
    "future_changes": "Revisit the proof if source bounds, divider widths, clock topology, direct independent LPTIM sources, families, or cycle count change."
  },
