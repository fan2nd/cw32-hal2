  "runtime_review_findings": [
    "native typed backend without raw adapter or runtime family switch",
    "exact-part memory and generic fail-closed safe admission",
    "paired IRQ9/10 with CORDIC IRQ11 and no channel5 extension",
    "post-clock startup inspection includes native current registers",
    "RESTART/SRCLOAD/DSTLOAD false at every native launch; native remaining count uses CCNT",
    "earlier-family CNT path, topology and launch semantics preserved",
    "permanent admission/raw revocation and safe static-owner quarantine",
    "own TC/noTE plus STATUS5 and software SOFTSRC0 before SRAM resource return",
    "pre-MMIO inactive ISR guard, own flags only, TE priority, wake after lock",
    "staged UART lifetime, EN before DMATX, clean completion before closure/reuse, TXBUSY flush",
    "x030-only borrowed hardware constructors and no native RX/SPI routes",
    "native PAC enum/access compatibility changes explicitly disclosed"
  ],
  "resolved_static_findings": [
    {
