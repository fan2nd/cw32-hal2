    "software_enable_may_be_zero": true,
    "cold_lsi_startup_supported": false,
    "detector_lse_edges": 128,
    "detector_lsi_cycles": 256,
    "sufficient_test": "256 * declared_lse_minimum_hz > 128 * 36080, with cycle-bound margin; no factory +/-3% inference"
  },
  "fault_detection_policies": [
    "StartupOnly",
    "MonitoredExistingRoutes"
  ],
  "startup_only": "Require and retain LSECCS=0; stable startup counting still works. STABLE is latched and later failure need not be detected.",
  "monitored_existing_routes": "Require stable legally operating unchanged LSI. Activate or retain CCS and existing protection routes; fault flags, selected timer inputs and brake outputs may change before an error return. No takeover or clearing borrowed state.",
  "new_start_admission": {
    "central": "Reject SYSCLK=LSE, MCO6, locks, old stable/ready/fault state, LSE IRQ enables, required domain reset; validate declarations first.",
    "rtc": "SOURCE4..7 reject; SOURCE0 requires six-row quiet control image plus explicit independent observer handover.",
    "uart": "Reject either SOURCE2 regardless RXEN/TXEN.",
    "lptim": "Reject EN1 ICLKSRC2; when RTC SOURCE0 also reject EN1 TRIGEN!=0 TRIGSEL1..5.",
    "gpio": "Under public whole-bank sampling/event prerequisite, inspect PB1/PB0 ownership; crystal analog pair; bypass PB1 digital input. Reject digital-output PB4/PB6 AF2 when new start and RTC SOURCE0. Preserve unrelated pads and flags.",
    "adc": "Require ADC.EN=0 before oscillator-pad changes."
  },
  "exact_reuse": "An already-enabled source requires exact drive/startup-drive/mode/wait/monitor/pad agreement, stable/no-fault observations and retained ownership. Do not rewrite oscillator, pads, monitor or LSI. Inherited crystal/PINLOCK ownership of PB0 is retained in bypass.",
  "public_handover": "Functional observer and GPIO-bank sampling/event conditions are explicit public init/try_init and Config.lse prerequisites, not inferred from register resemblance, clock gates or token absence, and not hidden Rust memory-safety obligations.",
