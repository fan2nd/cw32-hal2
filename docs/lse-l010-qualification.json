  "reset_polarity": "active_low; never release or assert resets to manufacture admission",
  "lsi_monitor_prerequisite": {
    "maximum_hz": 36080,
    "basis": "Own RM section4.4.2 PDF56/printed55: legal32.8kHz +/-10% range. STABLE alone proves neither this bound nor factory calibration. Section4.7.5 PDF72/printed71 gives an unspecified reset calibration value.",
    "stable_required": true,
